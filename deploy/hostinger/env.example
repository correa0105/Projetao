MAINTENANCE_AREAS=events,tower
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
BETTER_AUTH_SECRET=replace-with-64-random-hex-characters
ALVORADA_IMAGE=alvorada-cinzenta:hostinger
