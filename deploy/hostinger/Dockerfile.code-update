# For code-only releases over an already validated full image.
# Public/, data/ and existing migrations must match the base exactly.
# New additive numbered migrations are included in the verified release manifest.
# runtime-additions contains only the audited Nodemailer package and package locks;
# every pre-existing dependency remains identical to the full validated base.
ARG BASE_IMAGE=alvorada-cinzenta:hostinger
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
COPY --chown=node:node dist/client/assets/ /app/dist/client/assets/
COPY --chown=node:node dist/client/index.html /app/dist/client/index.html
COPY --chown=node:node dist/server/ /app/dist/server/
COPY --chown=node:node release.json /app/release.json

COPY --chown=node:node db/migrations/ /app/db/migrations/
COPY --chown=node:node runtime-additions/ /app/
